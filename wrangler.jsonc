{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burger-logger",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  "previews": {},
  // Static files in ./public (CSS, htmx) are served first; everything else reaches the Worker.
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "burger-logger",
      "database_id": "adae8622-75ff-411a-b562-41c41633d4a8",
      "migrations_dir": "migrations"
    }
  ]
}
